<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.GaplessPlayer</RootNamespace>
    <AssemblyVersion>0.1.0.5</AssemblyVersion>
    <FileVersion>0.1.0.5</FileVersion>

    <!-- Per-target defaults (Jellyfin 12 line, supported). The package version
         floats over stable 12.x like the official Jellyfin plugins do; the
         DLL then references the resolved version's assemblies, so
         scripts/build.sh sets the manifest targetAbi to that version.
         The frozen Jellyfin 10.11 build overrides on the command line:
           -p:JellyfinTfm=net9.0 -p:JellyfinAbiVersion=10.11.11
         An intermediate property is used because MSBuild special-cases a
         global TargetFramework and strips it from the outer build. -->
    <JellyfinTfm Condition="'$(JellyfinTfm)' == ''">net10.0</JellyfinTfm>
    <TargetFramework>$(JellyfinTfm)</TargetFramework>
    <JellyfinAbiVersion Condition="'$(JellyfinAbiVersion)' == ''">12.*</JellyfinAbiVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for the injection middleware (IStartupFilter, HttpContext).
         The shared framework is present in the Jellyfin runtime. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinAbiVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinAbiVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built client bundle (produced by the client build before packaging).
         A committed placeholder keeps the C# build self-contained. -->
    <None Remove="Web\gaplessPlayer.js" />
    <EmbeddedResource Include="Web\gaplessPlayer.js" />
  </ItemGroup>

</Project>
